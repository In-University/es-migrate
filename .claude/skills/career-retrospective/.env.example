# Copy to .env (same folder) and fill in. Real environment variables override these values.
# Alternative: keep your existing file and pass it:  scan_atlassian.py ... --env-file <path-to-.env>
# Never paste tokens into chat or commands; edit the file yourself. Both products are read-only here.

# --- Jira ---
# Data Center / Server: base URL INCLUDING the context path, e.g. https://jira.corp.local/jira
# Cloud: https://<site>.atlassian.net
JIRA_BASE_URL=
# DC: Personal Access Token (Profile > Personal Access Tokens), sent as Bearer.   Cloud: API token.
JIRA_TOKEN=
# Cloud only (Basic auth). Leave empty on Data Center with a PAT.
JIRA_EMAIL=

# --- Confluence ---
# DC: https://wiki.corp.local/confluence      Cloud: https://<site>.atlassian.net/wiki
CONFLUENCE_BASE_URL=
CONFLUENCE_TOKEN=
CONFLUENCE_EMAIL=

# Optional
# JIRA_FLAVOR=dc | cloud            (auto: cloud when the host ends with atlassian.net)
# CONFLUENCE_FLAVOR=dc | cloud
# ATLASSIAN_CA_BUNDLE=C:\path\to\corp-ca.pem   (self-signed / corporate CA)
