# Copy to .env (same folder) and fill in. .env is git-ignored.
# Real environment variables override values here.

# --- Data Center / Server (default) ---
# Include the context path if Confluence is not at the root, e.g. https://wiki.corp.local/confluence
CONFLUENCE_BASE_URL=
# Personal Access Token (Profile > Personal Access Tokens), sent as Bearer. Needs DC >= 7.9
CONFLUENCE_TOKEN=

# --- Atlassian Cloud (testing only) ---
# CONFLUENCE_BASE_URL=https://<site>.atlassian.net/wiki
# CONFLUENCE_EMAIL=you@example.com
# CONFLUENCE_TOKEN=<API token from id.atlassian.com>
CONFLUENCE_EMAIL=
